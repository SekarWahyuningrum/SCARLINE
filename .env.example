# ===================== SCARLINE — contoh konfigurasi =====================
# Salin file ini menjadi .env lalu isi nilainya. File .env TIDAK boleh di-commit.

# Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=isi-anon-public-key
# RAHASIA: hanya dipakai server Python untuk menyimpan skor/XP. Jangan pernah dikirim ke browser.
SUPABASE_SERVICE_ROLE_KEY=isi-service-role-key

# Kunci acak untuk menandatangani cookie sesi. Buat dengan:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=ganti-dengan-string-acak-panjang

# URL tempat aplikasi diakses (dipakai untuk tautan email konfirmasi & reset password)
SITE_URL=http://localhost:5000

# Pendaftaran: 0 (default) = akun langsung aktif lewat Admin API server, tanpa email
# (menghindari batas ±2 email/jam dari SMTP bawaan Supabase). 1 = wajib konfirmasi email.
REQUIRE_EMAIL_CONFIRMATION=0

# SCAR AI Tutor (opsional). Kunci dari https://console.anthropic.com — HANYA dipakai server.
# Kosongkan untuk memakai tutor dasar lokal (tetap bisa menghitung gradien/persamaan & menjelaskan konsep).
ANTHROPIC_API_KEY=
# TUTOR_MODEL=claude-opus-5-5

# Opsional
# FLASK_DEBUG=1
# PORT=5000
# SESSION_COOKIE_SECURE=true
