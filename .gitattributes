# Statistik bahasa GitHub (Linguist): SCARLINE ditulis dengan Python (backend)
# dan JavaScript (frontend interaktif). Template HTML Jinja, stylesheet CSS,
# dan SQL Supabase tetap ada di repo, tetapi tidak dihitung pada bilah bahasa.
*.html linguist-detectable=false
*.css  linguist-detectable=false
*.sql  linguist-detectable=false
*.svg  linguist-detectable=false

*.py   linguist-language=Python
*.js   linguist-language=JavaScript

# Normalisasi akhir baris
* text=auto eol=lf
*.png binary
